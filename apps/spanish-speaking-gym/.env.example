# Spanish Speaking Gym local environment
#
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# Optional: provide an OpenAI API key when adding API-backed practice features.
# The current MVP works without this value.
OPENAI_API_KEY=

# Optional: change the app URL when running behind a tunnel or alternate port.
NEXT_PUBLIC_APP_URL=http://localhost:3000
