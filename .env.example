# Copy this file to .env in local development and fill in values as needed.
# Never commit real API keys or webhook secrets.

# Required for examples and local scripts that call the OpenAI API.
OPENAI_API_KEY=

# Optional: used when verifying webhook signatures in webhook examples.
OPENAI_WEBHOOK_SECRET=

# Optional: enable SDK logging. Supported values include debug, info, warn, and error.
OPENAI_LOG=

# Optional: uncomment to use a custom OpenAI-compatible endpoint.
# OPENAI_BASE_URL=
